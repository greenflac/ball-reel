# ОБРАЗЕЦ. Скопировать в .env НА ТОЙ МАШИНЕ, где идёт прогон, и вписать
# настоящие значения. Сам .env закрыт .gitignore и в репозиторий не попадёт.
#
#   cp .env.example .env      # потом вписать ключи
#   set -a; . ./.env; set +a  # подхватить в текущую оболочку
#
# Ни одно из этих значений НЕ НУЖНО передавать в чат: домены fal.ai,
# queue.fal.run и api.klingai.com закрыты сетевой политикой песочницы
# (проверено: 403 на CONNECT), прогон оттуда невозможен независимо от ключей.

FAL_KEY=
KLING_KEY=

# Ссылки на входные файлы. fal.ai принимает URL, а не байты; либо загрузить
# файлы его же клиентом (fal_client.upload_file — НЕПРОВЕРЕНО), либо положить
# на любой доступный по HTTP адрес.
BENCH_VIDEO_URL=
BENCH_PHOTO_URL=
