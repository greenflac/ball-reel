conditions_clean/

# Доказательства живых прогонов отслеживаются НАМЕРЕННО: без них
# аудитор клонирует репозиторий и не видит ни одного подтверждения.
!evidence/
!evidence/**

# Сгенерированные кадры содержат лицо реального человека — в репозиторий,
# который уйдёт на аудит, они не идут. Числа по ним идут: см. evidence/.
startprobe/
bench_base/
ds_medoid/
ds_clean/
# Эксперимент с рёбрами: картинки ни в коде, ни в тестах не
# используются. marktest_*.png НЕ здесь намеренно — на них
# смотрят test_bodyparts и стенд calibrate_marks, и без них
# склонировавший получит красные тесты.
startprobe/
edge_*.png

# КЛЮЧИ И ЧЕРНОВИКИ СРАВНЕНИЯ С РЫНКОМ. Ключи в репозиторий не попадают
# никогда: они читаются из окружения либо из .env, которого здесь нет.
.env
.env.*
!.env.example
work/
bench_*/
